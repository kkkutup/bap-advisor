# ==============================================================================
# Mersin University BAP Regulation Compliance & Pre-Review System (bap-advisor)
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database & pgvector Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=bap_advisor
POSTGRES_USER=bap_user
POSTGRES_PASSWORD=bap_password_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bap_user:bap_password_change_me@localhost:5432/bap_advisor

# ------------------------------------------------------------------------------
# Security, JWT & Internal Service Tokens
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_signing_key_at_least_256_bits_long_for_hmac_sha256_mersin_bap
JWT_EXPIRATION_HOURS=24
INTERNAL_SERVICE_TOKEN=bap_internal_service_secure_token_secret_key_meu_2026

# ------------------------------------------------------------------------------
# File Storage & Regulation Directories
# ------------------------------------------------------------------------------
STORAGE_DIR=./data/uploads
REGULATIONS_DIR=./data/regulations

# ------------------------------------------------------------------------------
# Core API Service Configuration (Spring Boot 3 / Java 17)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
AI_ENGINE_BASE_URL=http://localhost:8001

# ------------------------------------------------------------------------------
# AI Engine Service Configuration (FastAPI / Python 3.12)
# ------------------------------------------------------------------------------
AI_ENGINE_PORT=8001
AI_ENGINE_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Dual-Mode LLM Gateway Configuration
# LLM_PROVIDER options: nanogpt | ollama | vllm
# ------------------------------------------------------------------------------
LLM_PROVIDER=nanogpt

# NanoGPT (Phase 1 Testing Mode)
NANOGPT_BASE_URL=https://api.nano-gpt.com/api/v1
NANOGPT_API_KEY=
NANOGPT_MODEL=openai/gpt-4.1

# Ollama (Phase 2 Local Production Mode)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b-instruct

# vLLM (Phase 2 Enterprise Local Production Mode)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=qwen2.5:14b-instruct

# Airgapped Mode Lock (true strictly disables all outbound public HTTP requests)
AIRGAPPED_MODE=false

# ------------------------------------------------------------------------------
# Local Embedding & Reranker Models (Always Local, Zero Re-indexing)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ------------------------------------------------------------------------------
# Hybrid OCR & Vision Fallback
# ------------------------------------------------------------------------------
ENABLE_VISION_OCR_FALLBACK=false
